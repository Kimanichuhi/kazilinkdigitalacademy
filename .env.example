APP_NAME="Kazilink Digital Academy"
APP_ENV=local
APP_KEY=
# MUST be false in production — true leaks stack traces (file paths, SQL,
# env values) to any visitor who triggers an error.
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kazilink
DB_USERNAME=kazilink
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (the app is served over HTTPS there) so the
# session/XSRF cookies get the Secure flag. Leave false for local http dev
# or the browser will silently refuse to store the cookie and login breaks.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kazilink.academy"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- M-Pesa Daraja (STK Push) ---------------------------------------------
# sandbox | production. Fill in once credentials are issued by Safaricom
# (Daraja portal: https://developer.safaricom.co.ke). The Payment module
# degrades gracefully (booking stays awaiting_payment) when these are blank
# or the API call fails — see Modules/Payment.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Daraja doesn't sign its callbacks, so this random secret in the callback
# path is what proves an incoming POST really came from Safaricom rather
# than someone replaying/guessing a checkout_request_id. Generate one with:
#   php artisan tinker --execute="echo Str::random(40);"
# Required (the callback endpoint rejects everything until this is set) —
# generate it before turning on real MPESA_* credentials.
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback/${MPESA_CALLBACK_SECRET}"

# --- Bank Transfer (static details shown to the student) -------------------
BANK_NAME="Equity Bank Kenya"
BANK_ACCOUNT_NAME="Kazilink Digital Academy Ltd"
BANK_ACCOUNT_NUMBER="0123456789"
BANK_BRANCH="Westlands, Nairobi"

# --- Stripe (stub only, mirrors source behavior — not wired to a real charge) ---
STRIPE_KEY=
STRIPE_SECRET=

# --- Microsoft Clarity (session replay) -------------------------------------
# Free, no Node dependency — just a script tag. Blank by default, matching
# every other optional integration above: the tracking snippet simply isn't
# rendered until this is set (Modules/Core layouts check this via
# config('services.clarity.project_id')). Get a project ID at
# https://clarity.microsoft.com. Sensitive fields (booking phone/ID
# number/payment reference, admin PII screens) are marked
# data-clarity-mask="true" in the Blade views so Clarity never records them,
# regardless of this being set.
CLARITY_PROJECT_ID=
