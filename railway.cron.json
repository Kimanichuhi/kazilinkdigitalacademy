{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "composer install --no-dev --optimize-autoloader"
  },
  "deploy": {
    "startCommand": "php artisan schedule:run",
    "cronSchedule": "* * * * *",
    "restartPolicyType": "NEVER"
  }
}
